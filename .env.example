# Copier en `.env.local`, qui est ignoré par git. Aucune de ces valeurs ne doit être commitée.

# --- FRED -------------------------------------------------------------------
# Clé gratuite : https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# --- Supabase ---------------------------------------------------------------
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Clé anonyme : lecture seule, protégée par les politiques RLS de supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé de service : écriture, utilisée par le seul cron. Ne jamais l'exposer au navigateur,
# ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron -------------------------------------------------------------------
# Chaîne aléatoire longue. Vercel l'envoie en en-tête `Authorization: Bearer ...` à chaque
# déclenchement ; la route refuse tout appel qui ne la porte pas. Sans elle, n'importe qui
# peut déclencher vos appels FRED.
CRON_SECRET=
